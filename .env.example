# Application Environment
ENVIRONMENT=development
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# Database Connection (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite+aiosqlite:///./data/hr_contacts.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hr_contacts

# Web Crawler Settings
CRAWLER_MAX_CONCURRENCY=5
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_PAGES_PER_COMPANY=25
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36 (Public HR Contact Research Tool)
CRAWLER_MAX_RETRIES=3

# Public Search Engine Settings
ENABLE_SEARCH_ENGINE=true
SEARCH_RATE_LIMIT_DELAY=1.0
SEARCH_MAX_RESULTS=8

# Optional Third-Party Fallback APIs (Optional)
FIRECRAWL_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Next.js Frontend
NEXT_PUBLIC_API_URL=/api/v1
