# ============================================================================
# HR Contact Intelligence Platform – environment template
# Copy to `.env` (never commit `.env` to Git – it is git-ignored).
# ============================================================================

# ------------------------------- Application --------------------------------
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------- Security -----------------------------------
# REQUIRED for production. Generate with: openssl rand -hex 48
SECRET_KEY=change-me-to-a-long-random-string
# Separate key used to encrypt provider API keys stored in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ------------------------------- Database -----------------------------------
# Local development defaults to SQLite. Docker Compose automatically sets this
# to the PostgreSQL service below.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hr_platform
RUN_MIGRATIONS=true

# ------------------------------- Authentication -----------------------------
# Google OAuth: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: {BACKEND_PUBLIC_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------- SMTP (optional) -----------------------------
# When empty, verification/reset links are logged + returned in dev API responses.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.com
SMTP_STARTTLS=true

# ------------------------------- CAPTCHA -------------------------------------
# none | dev-math | turnstile | recaptcha | hcaptcha
CAPTCHA_PROVIDER=dev-math
CAPTCHA_SECRET_KEY=
CAPTCHA_SITE_KEY=

# ------------------------------- Crawler -------------------------------------
CRAWLER_MAX_CONCURRENCY=5
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_PAGES_PER_COMPANY=30
CRAWLER_MAX_RETRIES=2
CRAWLER_RESPECT_ROBOTS=true
# Browser fallback (requires `pip install playwright && playwright install chromium`)
ENABLE_PLAYWRIGHT=false
PLAYWRIGHT_MAX_PAGES=8

# ------------------------------- Search --------------------------------------
ENABLE_PUBLIC_SEARCH=true
SEARCH_RATE_LIMIT_DELAY=1.0
SEARCH_MAX_RESULTS=8

# ------------------------------- Rate limiting --------------------------------
RATE_LIMIT_AUTH=8/minute
RATE_LIMIT_SEARCH=20/minute
RATE_LIMIT_DEFAULT=240/minute

# ------------------------------- Paid providers (optional, can also be set
# per-user via Settings → Providers inside the app; DB keys take precedence)
FIRECRAWL_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ------------------------------- Frontend (Next.js) ---------------------------
# Server-side proxy target used in next.config.mjs (browser calls are relative).
API_INTERNAL_URL=http://localhost:8000
